# Скопируйте в .env и заполните своими значениями.
# Секреты (API_TOKEN, DATABASE_URL, MOODLE_WS_TOKEN) не публикуйте в Git.

MOODLE_LOGIN=nikita
MOODLE_FULL_NAME=Никифоров Никита Сергеевич
API_TOKEN=
DATABASE_URL=

# Включите TLS (1), если БД требует SSL-подключение (например, Supabase).
# При DATABASE_TLS=1 не указывайте sslmode в DATABASE_URL.
DATABASE_TLS=1
# DATABASE_CA_FILE=/path/to/ca.crt

PORT=3000

# Опционально: отдельная административная строка подключения для npm run db:init
# DATABASE_ADMIN_URL=

# Для сквозной проверки (npm run verify)
# APP_URL=http://localhost:3000
# CHECKER_DATABASE_URL=

# Для отправки доступов преподавателю через Moodle REST API (npm run moodle:send)
# MOODLE_BASE_URL=https://node-server.ru/m/
# MOODLE_WS_TOKEN=
# MOODLE_TEACHER_ID=
